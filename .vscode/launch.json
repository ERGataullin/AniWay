{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "program": "lib/main.dart",
            "args": [
                "--web-experimental-hot-reload",
                "--web-port=8080",
                "--web-browser-flag=--disable-web-security",
            ]
        },
        {
            "name": "Debug (mocked)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "program": "lib/main.dart",
            "args": [
                "--web-experimental-hot-reload",
                "--web-port=8008",
                "--web-browser-flag=--disable-web-security",
                "--dart-define=USE_MOCKS=true"
            ]
        },
        {
            "name": "Profile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart",
            "args": [
                "--web-experimental-hot-reload",
                "--web-port=8080",
                "--web-browser-flag=--disable-web-security",
            ]
        },
        {
            "name": "Release",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "args": [
                "--web-experimental-hot-reload",
                "--web-port=8080",
                "--web-browser-flag=--disable-web-security",
            ]
        }
    ]
}
