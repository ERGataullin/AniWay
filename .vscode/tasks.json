{
	"version": "2.0.0",
	"problemMatcher": [],
	"presentation": {
		"close": true,
		"echo": true,
		"reveal": "silent",
	},
	"tasks": [
		{
			"label": "Build .apk",
			"type": "shell",
			"presentation": {
				"reveal": "always",
			},
			"command": [
				"flutter build apk --release; ",
				"cd build/app/outputs/apk/release; ",
				"mv app-release.apk AniWay.apk; ",
			],
		},
		{
			"label": "Checkout dev & Pull",
			"type": "shell",
			"command": [
				"git checkout dev; ",
				"git pull; ",
			],
		},
		{
			"label": "Generate l10n",
			"type": "shell",
			"command": "flutter gen-l10n",
		},
	]
}
